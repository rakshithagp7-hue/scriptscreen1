# --- LLM (pick ONE; with no key the app still runs using the offline heuristic adapter) ---
LLM_PROVIDER=gemini            # gemini | openai | none
GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-2.5-flash  # change if Google renames/retires the model
# OpenAI-compatible (Groq is free): set LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=llama-3.3-70b-versatile

# 1 = no network at all (silent video + procedural visuals). Last-resort demo mode.
OFFLINE=0
